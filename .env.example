# emblazon configuration

# Preview server and emblem API port (`just dev`, Docker)
PORT=4747

# Public base URL for links in API responses and docs (e.g., https://emblems.example.com).
# Set it in production so URLs never come from request headers.
PUBLIC_URL=

# Set to 1 behind a reverse proxy or CDN so client IPs come from its forwarding headers.
# Leave off when the server is exposed directly, or clients could spoof their identity.
TRUST_PROXY=

# Per-client rate limit: sustained requests per minute (0 turns it off) and burst size
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60

# Docker registry for releases (e.g., registry.example.com), used by `just release`
REGISTRY_URL=
