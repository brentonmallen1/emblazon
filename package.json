{
  "name": "emblazon",
  "version": "0.0.0",
  "description": "Deterministic heraldic and insignia avatars from any string.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "assets/CREDITS.md"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --watch server.ts",
    "start": "node server.ts",
    "sheet": "node scripts/sheet.ts",
    "draw": "node scripts/draw-geometric.ts",
    "import-icons": "node scripts/import-game-icons.ts",
    "assets": "node scripts/build-assets.ts",
    "stats": "node scripts/stats.ts",
    "build": "node scripts/build.ts",
    "test": "node --test \"test/**/*.test.ts\""
  }
}
